# Base URL of the API. `pnpm dev:local` sets it to http://localhost:8787 automatically.
VITE_API_URL=

# Read from the shell environment at build time, not from this file:
# VITE_BASE=      base path, set to /<repo>/ by CI for GitHub Pages (default /)
# E2E_BASE_URL=   run the Playwright suite against a deployed URL instead of a local build
